/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

    // publishDir = params.publish_all? [
    //     path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
    //     mode: params.publish_dir_mode,
    //     saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    // ] : []

process {

    withName: 'BCFTOOLS_.*' {
        container = "staphb/bcftools:1.20"
    }

    withName: VCF_ID_REPAIR:BCFTOOLS_QUERY_SAMPLE {
        ext.args = "--list-samples"
    }

    withName: '.*VCF_ID_REPAIR:BCFTOOLS_REHEADER_SAMPLE' {
        ext.args   = ''
        ext.args2  = {"--output-type z --write-index=tbi" }
        ext.prefix = { vcf.baseName - ".vcf" + ".reheader"}
        // publishDir = [
        //     path: { "${params.outdir}/bcftools_reheader" },
        //     mode: params.publish_dir_mode,
        //     saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        // ]
    }
    withName: FQ_LINT {
        ext.args = '--lint-mode log'
        publishDir = [
            path: { "${params.outdir}/reports/fq_lint" },
            mode: params.publish_dir_mode,
            pattern: '*_lint.txt'
        ]
    }

    withName: SEQFU_CHECK {
        ext.args = '--safe-exit --deep'
        publishDir = [
            path: { "${params.outdir}/reports/seqfu_check" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: FASTQC {
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/reports/fastqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CREATE_FAMILY_PED {
        publishDir = [ 
            path: { "${params.outdir}/results/ped_files/" },
            mode: params.publish_dir_mode,
            pattern : '*.ped'
        ]
    }

    withName: PICARD_VALIDATESAMFILE {
        errorStrategy = 'ignore'
        ext.args = '--CREATE_MD5_FILE true --QUIET true --MODE SUMMARY --INDEX_VALIDATION_STRINGENCY NONE --VALIDATE_INDEX false --IGNORE INVALID_TAG_NM --IGNORE MISSING_TAG_NM'
        ext.prefix = { meta.id + ".validatesam"}
        publishDir = [
            path: { "${params.outdir}/reports/alignment/picard/validatesam/" },
            mode: params.publish_dir_mode,
            pattern : '*.txt'
        ]
    }

    withName: '.*BAM_ID_REPAIR:SAMTOOLS_REHEADER_SAMPLE' {
        ext.args = {'-P -c \'sed -E \"/^@RG/ s/SM:\\S+/SM:' + "${meta.participant_sample}" + '/g\" \' '}
        ext.prefix = { "${meta.id}" }
    }

    withName: 'QUALIMAP_.*' {
        ext.prefix = { meta.id + ".qualimap"}
        publishDir = [
            path: { "${params.outdir}/reports/alignment/qualimap/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SOMALIER_RELATE {
        ext.prefix = { meta.id + ".somalier"}
        publishDir = [
            path: { "${params.outdir}/reports/alignment/somalier/" },
            mode: params.publish_dir_mode,
            pattern : '{*.html,*.tsv}'
        ]
    }

    withName: SOMALIER_EXTRACT {
        publishDir = [
            path: { "${params.outdir}/reports/alignment/somalier/extract/" },
            mode: params.publish_dir_mode,
            pattern : '*.somalier'
        ]
    }

    withName: VERIFYBAMID_VERIFYBAMID2 {
        ext.args = {"--DisableSanityCheck --Output " + meta.id}
        publishDir = [
            path: { "${params.outdir}/reports/alignment/verifybamid2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}

workflow {
    failOnIgnore = true
}
