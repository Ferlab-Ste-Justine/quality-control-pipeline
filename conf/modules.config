/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

    // publishDir = params.publish_all? [
    //     path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
    //     mode: params.publish_dir_mode,
    //     saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    // ] : []

process {

    publishDir = [
        path: { "${params.outdir}/reports/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]


    withName: 'BCFTOOLS_.*' {
        container = "docker.io/staphb/bcftools:1.20"
    }

    // withName: 'PICARD_.*' {
    //     // container = "docker.io/broadinstitute/picard:latest"
    //     container = "docker.io/broadinstitute/picard:3.4.0"
    // }

    withName: VCF_ID_REPAIR:BCFTOOLS_QUERY_SAMPLE {
        ext.args = "--list-samples"
    }

    withName: '.*VCF_ID_REPAIR:BCFTOOLS_REHEADER_SAMPLE' {
        ext.args   = ''
        ext.args2  = {"--output-type z --write-index=tbi" }
        ext.prefix = { vcf.baseName - ".vcf" + ".reheader"}
        // publishDir = [
        //     path: { "${params.outdir}/bcftools_reheader" },
        //     mode: params.publish_dir_mode,
        //     saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        // ]
    }

    withName: '.*FASTQ_QC:*' {
        publishDir = [
            path: { "${params.outdir}/reports/${meta.sequencingType}/fastq_qc/"}
        ]
    }

    withName: FASTQC {
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/reports/fastqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: CREATE_FAMILY_PED {
        publishDir = [
            path: { "${params.outdir}/results/ped_files/" },
            mode: params.publish_dir_mode,
            pattern : '*.ped'
        ]
    }

    withName: '.*BAM_ID_REPAIR:SAMTOOLS_REHEADER_SAMPLE' {
        ext.args = {'-P -c \'sed -E \"/^@RG/ s/SM:\\S+/SM:' + "${meta.participant_sample}" + '/g\" \' '}
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/results/${meta.sequencingType}/ID_rename/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName:'.*BAM_MERGE.*:.*'{
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/results/${meta.sequencingType}/Merged/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SAMTOOLS_MERGE {
        ext.args = '-c -p'
    }

    withName: MOSDEPTH {
        ext.prefix = { meta.id + ".mosdepth"}
        ext.args = "--d4"
        publishDir = [
            path: { "${params.outdir}/reports/${meta.sequencingType}/alignment/mosdepth/${meta.id}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SAMTOOLS_SAMPLES {
        publishDir = [
            path: { "${params.outdir}/reports/${meta.sequencingType}/alignment/samples/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SOMALIER_*' {
        container = "biocontainers/somalier:0.3.0--hc78c8e0_0"
    }

    withName: SOMALIER_RELATE {
        ext.args = "--infer"
        ext.prefix = { meta.id + ".somalier"}
        publishDir = [
            path: { "${params.outdir}/reports/somalier/" },
            mode: params.publish_dir_mode,
            pattern : '{*.html,*.tsv}'
        ]
    }

    withName: SOMALIER_EXTRACT {
        publishDir = [
            path: { "${params.outdir}/reports/${meta.sequencingType}/alignment/somalier/extract/" },
            mode: params.publish_dir_mode,
            pattern : '*.somalier'
        ]
    }

    withName: VERIFYBAMID_VERIFYBAMID2 {
        ext.args = {"--DisableSanityCheck --NumPC 4 --Output " + meta.id}
        publishDir = [
            path: { "${params.outdir}/reports/${meta.sequencingType}/alignment/verifybamid2" },
            mode: params.publish_dir_mode,
            pattern: '*.log',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC.*' {
        container = "biocontainers/multiqc:1.32--pyhdfd78af_0"
        // ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}

workflow {
    failOnIgnore = true
}
