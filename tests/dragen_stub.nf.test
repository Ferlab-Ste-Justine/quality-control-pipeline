nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    // Replaces nf-test.config's default "test" profile for this file only:
    // conf/test.config sets params.ped_file, which this test needs unset.
    // A `+`-prefixed CLI profile (e.g. `--profile +docker`, as CI uses) is
    // appended to it; a CLI profile without `+` replaces it.
    profile "test_dragen"

    // -stub counterpart of tests/dragen.nf.test -- same mixed standard +
    // DRAGEN samplesheet, confirming the DRAGEN branch (UNTAR,
    // DRAGEN_COVERAGE_BY_GENE, per-sample dragenMetrics handling) also wires
    // up and completes under -stub. See tests/default_stub.nf.test for why
    // this exists; content is fake, so this only asserts success.
    test("-profile test_dragen -stub (mixed standard + DRAGEN samples)") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                cohort_mode = false
                input = "${projectDir}/tests/fixtures/dragen_mixed_samplesheet.csv"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                { assert snapshot(
                    removeFromYamlMap("$outputDir/pipeline_info/quality-control-pipeline_software_mqc_versions.yml", "Workflow")
                ).match() }
            )
        }
    }
}
