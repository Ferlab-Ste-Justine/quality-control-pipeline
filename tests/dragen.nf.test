nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    // Replaces nf-test.config's default "test" profile for this file only:
    // conf/test.config sets params.ped_file, which this test needs unset.
    // A `+`-prefixed CLI profile (e.g. `--profile +docker`, as CI uses) is
    // appended to it; a CLI profile without `+` replaces it.
    profile "test_dragen"

    test("-profile test_dragen (mixed standard + DRAGEN samples)") {

        when {
            params {
                outdir = "$outputDir"
                cohort_mode = false
                input = "${projectDir}/tests/fixtures/dragen_mixed_samplesheet.csv"
                // Exercises all three per-sample dragenMetrics shapes in one run:
                // NA19240 (blank -> standard recompute), NA19239 (directory),
                // NA19238 (tarball) -- NA19240/NA19239/NA19238 share the YRI family,
                // so the family's MultiQC report blends standard and DRAGEN-sourced
                // metrics together. NA21118 (CEU) is a fully-DRAGEN family with
                // cov_report/read_cov_report beds, exercising DRAGEN_COVERAGE_BY_GENE.
                // NA21119 (SAS) is a fully-standard singleton.
                // cnv_metrics.csv (BIOINFO-243) is present for NA19238 (inside the
                // tarball) and NA21118 (directory), but deliberately absent for
                // NA19239 -- exercises both input shapes for the CNV Metrics table,
                // plus the "no cnv_metrics.csv -> blank cells, run still succeeds"
                // acceptance criterion in the same run.
                // CollectHsMetrics.out (BIOINFO-245) is present for NA19238 only (WXS;
                // DRAGEN produces no WGS equivalent) -- its wgs_coverage_metrics.csv
                // was removed from the fixture to match (a real DRAGEN WXS run
                // wouldn't produce one either), so Mean Autosome Coverage / %
                // Autosomes >=15X for NA19238 can only come from this file, proving
                // MultiQC's content-detected picard module is what's actually
                // supplying them. NA19239/NA21118 have no CollectHsMetrics.out,
                // covering the "missing file doesn't fail the run" case.
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeFromYamlMap("$outputDir/pipeline_info/quality-control-pipeline_software_mqc_versions.yml","Workflow"),
                    // All stable path name, with a relative path
                    stable_name,
                    // All files with stable contents
                    stable_path
                ).match() }
            )
        }
    }
}
